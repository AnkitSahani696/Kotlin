<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="start"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/circular_background"
        android:contentDescription="Back"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back" />

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#4DB6AC"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:title="App Info"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- App Info Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Application Information"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333"
                        android:layout_marginBottom="16dp" />

                    <!-- App Icon and Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/ic_admin"
                            android:layout_marginEnd="16dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="INSPIRE-TOOL"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#333" />

                            <TextView
                                android:id="@+id/appVersionText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Version: 1.0.0"
                                android:textSize="14sp"
                                android:textColor="#666" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- App Details -->
                    <TextView
                        android:id="@+id/buildNumberText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Build: 1"
                        android:textSize="14sp"
                        android:textColor="#666"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/developerText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Developer: Ankit Sahani"
                        android:textSize="14sp"
                        android:textColor="#666"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="© 2025-2026 All Rights Reserved"
                        android:textSize="12sp"
                        android:textColor="#999" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- PDF Upload Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PDF Documents"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#333" />

                        <TextView
                            android:id="@+id/totalPdfsText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total PDFs: 0"
                            android:textSize="12sp"
                            android:textColor="#666"
                            android:background="#E8F5E8"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp" />

                    </LinearLayout>

                    <!-- Upload Button -->
                    <Button
                        android:id="@+id/uploadPdfButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="📄 Upload PDF Documents"
                        android:textSize="16sp"
                        android:background="#4DB6AC"
                        android:textColor="@android:color/white"
                        android:layout_marginBottom="16dp" />

                    <!-- PDF List -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/pdfRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <!-- No PDFs Message -->
                    <TextView
                        android:id="@+id/noPdfsText"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:text="No PDF documents uploaded\nTap 'Upload PDF Documents' to add files"
                        android:textSize="14sp"
                        android:textColor="#666"
                        android:gravity="center"
                        android:background="#FAFAFA"
                        android:visibility="visible" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>